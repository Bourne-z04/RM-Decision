<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="BehaviorTree">
  <BehaviorTree ID="BehaviorTree">
    <ReactiveSequence>
      <SubGameStatus topic_name="/feedback_game_progress"
                     game_progress="{game_progress}"/>
      <SubRobotStatus topic_name="/feedback_ally_7_hp"
                      ally_7_robot_hp="{ally_7_robot_hp}"/>
      <WhileDoElse>
        <IsGameTime name="IsGameStart"
                    message="{game_progress}"
                    game_progress="4"/>
        <ReactiveSequence>
          <WhileDoElse>
            <IsRetreat name="NeedRetreat"
                      message="{ally_7_robot_hp}"
                      hp_threshold_retreat="100"/>
            <RateController hz="1">
                <SendGoal name="SupplyArea"
                                goal_pose="0;0;0;0;0;0;1"
                                action_name="/navigate_to_pose"/>
            </RateController>
            <Sequence>
                <Sleep msec="2000"/>
                <RateController hz="1">
                    <SendGoal name="OccupyArea"
                                    goal_pose="4.89;-3;0;0;0;0;1"
                                    action_name="/navigate_to_pose"/>
                </RateController>
            </Sequence>
          </WhileDoElse>
        </ReactiveSequence>
        <RateController hz="1">
            <SendGoal name="Home"
                            goal_pose="0;0;0;0;0;0;1"
                            action_name="/navigate_to_pose"/>
        </RateController>
      </WhileDoElse>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="Sleep"
            editable="true">
      <input_port name="msec"
                  default="1000"/>
    </Action>
    <Action ID="IsRetreat"
            editable="true">
      <input_port name="message"
                  default="{ally_7_robot_hp}"/>
      <input_port name="hp_threshold_retreat"
                  default="100"/>
    </Action>
    <Action ID="IsGameTime"
            editable="true">
      <input_port name="message"
                  default="{game_progress}"/>
      <input_port name="game_progress"
                  default="4"/>
    </Action>
    <Action ID="SendGoal"
            editable="true">
      <input_port name="goal_pose"
                  default="0;0;0;0;0;0;1"/>
      <input_port name="action_name"
                  default="/navigate_to_pose"/>
    </Action>
    <Action ID="SubGameStatus"
            editable="true">
      <input_port name="topic_name"
                  default="/feedback_game_progress"/>
      <output_port name="game_progress"
                   default="{game_progress}"/>
    </Action>
    <Action ID="SubRobotStatus"
            editable="true">
      <input_port name="topic_name"
                  default="/feedback_ally_7_hp"/>
      <output_port name="ally_7_robot_hp"
                   default="{ally_7_robot_hp}"/>
    </Action>
  </TreeNodesModel>

</root>
