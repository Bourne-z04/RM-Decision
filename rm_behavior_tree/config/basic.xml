<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
  <BehaviorTree ID="BehaviorTree">
    <ReactiveSequence>
      <SubGameStatus topic_name="/feedback_game_progress" game_progress="{game_progress}"/>
      <SubRobotStatus topic_name="/feedback_robot_hp" feedback_robot_hp="{feedback_robot_hp}"/>
      <GetCurrentLocation name="GetLocation" current_location="{current_location}"/>

      <WhileDoElse>
        <IsGameTime name="IsGameStart" message="{game_progress}" game_progress="4"/>

        <ReactiveSequence>
          
          <ForceSuccess>
            <ReactiveFallback>
              <Sequence>
                <IsNearGoal current_location="{current_location}" goal_pose="6.0;-3.75;0;0;0;0;1" distance_threshold="1.5"/>
                <SendSpin is_spin="true" spin_velocity="4.0" spin_amplitude="0.5" spin_period="5.0" topic_name="/cmd_vel_wz"/>
              </Sequence>
              <Sequence>
                <IsNearGoal current_location="{current_location}" goal_pose="5.0;-5.0;0;0;0;0;1" distance_threshold="1.5"/>
                <SendSpin is_spin="true" spin_velocity="4.0" spin_amplitude="0.5" spin_period="5.0" topic_name="/cmd_vel_wz"/>
              </Sequence>
              <Sequence>
                <IsNearGoal current_location="{current_location}" goal_pose="5.0;-3.0;0;0;0;0;1" distance_threshold="1.5"/>
                <SendSpin is_spin="true" spin_velocity="4.0" spin_amplitude="0.5" spin_period="5.0" topic_name="/cmd_vel_wz"/>
              </Sequence>
              <SendSpin is_spin="false" spin_velocity="0" topic_name="/cmd_vel_wz"/>
            </ReactiveFallback>
          </ForceSuccess>

          <WhileDoElse>
            <IsRetreat name="NeedRetreat" message="{feedback_robot_hp}" hp_threshold_retreat="110" hp_threshold_recover="400"/>

            <SendGoal name="Supply" goal_pose="-0.25;0.0;0;0;0;0;1" action_name="/navigate_to_pose" move="false"/>

            <ReactiveFallback>
              
              <Sequence>
                <IsHPdeduction message="{feedback_robot_hp}"/>
                <Timeout msec="5000">
                    <SendGoal name="RandomMove" goal_pose="5.0;-5.0;0;0;0;0;1" action_name="/navigate_to_pose" move="true" length="1"/>
                </Timeout>
              </Sequence>

              <Sequence>
                <IsHPLevel name="HPbelow200" message="{feedback_robot_hp}" hp_threshold="200"/>
                <Fallback>
                  <Timeout msec="5000">
                    <SendGoal name="Back" goal_pose="5.0;-5.0;0;0;0;0;1" action_name="/navigate_to_pose" move="false"/>
                  </Timeout>
                  <Timeout msec="5000">
                    <SendGoal name="Back" goal_pose="5.0;-5.0;0;0;0;0;1" action_name="/navigate_to_pose" move="true" length="1"/>
                  </Timeout>
                </Fallback>
              </Sequence>
              
              <Fallback>
                <Timeout msec="5000">
                  <SendGoal name="Attack" goal_pose="6.0;-3.75;0;0;0;0;1" action_name="/navigate_to_pose" move="false"/>
                </Timeout>
                <Timeout msec="5000">
                  <SendGoal name="Center" goal_pose="5.0;-3.0;0;0;0;0;1" action_name="/navigate_to_pose" move="true" length="1"/>
                </Timeout>
              </Fallback>

            </ReactiveFallback>
          </WhileDoElse>
        </ReactiveSequence>

        <Sequence>
          <SendSpin is_spin="false" spin_velocity="0" topic_name="/cmd_vel_wz"/>
          <SendGoal name="Home" goal_pose="0;0;0;0;0;0;1" action_name="/navigate_to_pose" move="false"/>
        </Sequence>

      </WhileDoElse>
    </ReactiveSequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Condition ID="IsHPLevel" editable="true">
      <input_port name="message" default="{feedback_robot_hp}"/>
      <input_port name="hp_threshold" default="200"/>
    </Condition>
    <Condition ID="IsRetreat" editable="true">
      <input_port name="message" default="{feedback_robot_hp}"/>
      <input_port name="hp_threshold_retreat" default="110"/>
      <input_port name="hp_threshold_recover" default="500"/>
    </Condition>
    <Condition ID="IsHPdeduction" editable="true">
      <input_port name="message" default="{feedback_robot_hp}"/>
    </Condition>
    <Condition ID="IsGameTime" editable="true">
      <input_port name="message" default="{game_progress}"/>
      <input_port name="game_progress" default="4"/>
    </Condition>
    <Action ID="SendGoal" editable="true">
      <input_port name="goal_pose" default="0;0;0;0;0;0;1"/>
      <input_port name="action_name" default="/navigate_to_pose"/>
      <input_port name="move" default="false"/>
      <input_port name="length" default="1.0"/>
    </Action>
    <Action ID="GetCurrentLocation" editable="true">
      <output_port name="current_location" default="{current_location}"/>
    </Action>
    <Condition ID="IsNearGoal" editable="true">
      <input_port name="current_location" default="{current_location}"/>
      <input_port name="goal_pose" default="0;0;0;0;0;0;1"/>
      <input_port name="distance_threshold" default="2.0"/>
    </Condition>
    <Action ID="SendSpin" editable="true">
      <input_port name="is_spin" default="true"/>
      <input_port name="spin_velocity" default="5.0"/>
      <input_port name="spin_amplitude" default="0.5"/>
      <input_port name="spin_period" default="5.0"/>
      <input_port name="topic_name" default="/cmd_vel_wz"/>
    </Action>
    <Action ID="SubGameStatus" editable="true">
      <input_port name="topic_name" default="/feedback_game_progress"/>
      <output_port name="game_progress" default="{game_progress}"/>
    </Action>
    <Action ID="SubRobotStatus" editable="true">
      <input_port name="topic_name" default="/feedback_robot_hp"/>
      <output_port name="feedback_robot_hp" default="{feedback_robot_hp}"/>
    </Action>
    <Decorator ID="IfThenElse" editable="true"/>
    <Decorator ID="WhileDoElse" editable="true"/>
    <Decorator ID="RateController" editable="true">
      <input_port name="hz" default="1.0"/>
    </Decorator>
    <Decorator ID="ForceSuccess" editable="true"/>
    <Decorator ID="Fallback" editable="true"/>
    <Decorator ID="Timeout" editable="true">
      <input_port name="msec" default="5000"/>
    </Decorator>
  </TreeNodesModel>
</root>