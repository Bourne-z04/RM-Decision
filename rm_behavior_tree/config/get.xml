<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
  
  <BehaviorTree ID="BehaviorTree">
    <ReactiveSequence>
      <RateController hz="1.0">
        <GetCurrentLocation name="GetLocation" current_location="{current_location}"/>    
      </RateController>
    </ReactiveSequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="GetCurrentLocation">
      <output_port name="current_location" default="{current_location}">Output for current location</output_port>
    </Action>

    <Action ID="SendSpin" editable="true">
      <input_port name="is_spin" default="true"/>
      <input_port name="spin_velocity" default="0.5"/>
      <input_port name="topic_name" default="/cmd_vel_wz"/>
    </Action>
    
    <Decorator ID="RateController">
      <input_port name="hz" default="1.0"/>
    </Decorator>
  </TreeNodesModel>

</root>